# Scriptora environment variables
# Copy this file to `.env` and fill in your own values.
#   cp .env.example .env     (macOS / Linux)
#   copy .env.example .env   (Windows PowerShell)
#
# `.env` is git-ignored. NEVER commit a real key.

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------
# AssemblyAI API key. Used for BOTH:
#   1. Real-time Speech-to-Text streaming (the transcript)
#   2. The LLM Gateway that powers context-aware correction
#
# Get one at https://www.assemblyai.com/dashboard/signup
# Hackathon keys come from the AssemblyAI hackathon signup flow.
ASSEMBLYAI_API_KEY=

# ---------------------------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------------------------
# Speech model for real-time streaming. See the AssemblyAI model list.
SCRIPTORA_SPEECH_MODEL=universal-3-5-pro

# LLM used by the correction engine, via the AssemblyAI LLM Gateway
# (OpenAI-compatible endpoint, authenticated with the same AssemblyAI key).
# Set to "rules" to force the deterministic offline corrector instead.
SCRIPTORA_CORRECTOR_BACKEND=auto
SCRIPTORA_LLM_MODEL=qwen3.5-4b-32k-fast

# Turn detection. `balanced` suits dictation/subtitles; `min_latency` is snappier,
# `max_accuracy` is more conservative about closing a turn.
SCRIPTORA_STREAM_MODE=balanced

# Server bind settings
SCRIPTORA_HOST=127.0.0.1
SCRIPTORA_PORT=8000
